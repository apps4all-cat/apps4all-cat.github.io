---
import Base from '../layouts/Base.astro';
import { routes } from '../i18n';
import { texts } from '../content';

const ca = texts('ca').error_404;
const es = texts('es').error_404;
---

<Base lang="ca" title={ca.titol} alternate={routes.es.home}>
  <div class="wrap estret">
    <h1>{ca.titol}</h1>
    <p lang="es" class="suau">{es.titol}.</p>
    <p><a class="btn" href={routes.ca.home}>{ca.tornar}</a></p>
  </div>
</Base>

<style>
  .estret { max-width: 44rem; padding-top: 56px; padding-bottom: 56px; }
</style>
