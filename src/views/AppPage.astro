---
import Base from '../layouts/Base.astro';
import type { App } from '../data/apps';
import { t, routes, langNameIn, type Lang } from '../i18n';

interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const tx = t[lang].app;
const other: Lang = lang === 'ca' ? 'es' : 'ca';
const hasStore = app.playUrl || app.fdroidUrl;
---

<Base lang={lang} title={app.name[lang]} description={app.shortDesc[lang]} alternate={routes[other].app(app.id)}>
  <article class="wrap fitxa">
    <a class="tornar" href={`${routes[lang].home}#apps`}>{tx.back}</a>

    <header class="cap">
      <img src={app.icon} width="112" height="112" alt="" />
      <div>
        <h1>{app.name[lang]}</h1>
        <p class="lead">{app.shortDesc[lang]}</p>
        {app.audience === 'escola' && <span class="tag">{tx.forSchool}</span>}
      </div>
    </header>

    <div class="cos">
      <div>
        <p>{app.longDesc[lang]}</p>
        <h2>{tx.features}</h2>
        <ul class="punts">{app.features[lang].map((f) => <li>{f}</li>)}</ul>
      </div>

      <aside class="caixa">
        <h2 class="visually-h3">{tx.get}</h2>
        {hasStore ? (
          <div class="botons">
            {app.playUrl && <a class="btn" href={app.playUrl}>Google Play</a>}
            {app.fdroidUrl && <a class="btn btn-sec" href={app.fdroidUrl}>F-Droid</a>}
          </div>
        ) : (
          <p class="suau">{tx.soon}</p>
        )}
        <dl>
          <dt>{tx.version}</dt><dd>{app.version}</dd>
          <dt>{tx.languages}</dt><dd>{app.languages.map((l) => langNameIn[lang][l]).join(', ')}</dd>
          <dt>{tx.permissions}</dt><dd>{app.permissions.length ? app.permissions.join(', ') : tx.noPermissions}</dd>
        </dl>
        <ul class="enllacos">
          {app.privacyUrl && <li><a href={app.privacyUrl}>{tx.privacy}</a></li>}
          {app.repoUrl && <li><a href={app.repoUrl}>{tx.source}</a></li>}
        </ul>
      </aside>
    </div>

    {app.screenshots.length > 0 && (
      <section>
        <h2>{tx.screenshots}</h2>
        <ul class="captures">
          {app.screenshots.map((src, i) => (
            <li><img src={src} width="540" height="960" loading="lazy" alt={`${app.name[lang]} · ${i + 1}`} /></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .fitxa { padding-top: 24px; padding-bottom: 32px; }
  .tornar { display: inline-block; margin-bottom: 20px; text-decoration: none; font-weight: 600; }
  .cap { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin-bottom: 32px; }
  .cap img { width: 112px; height: 112px; border-radius: 26px; }
  .cap h1 { margin-bottom: 0.2em; }
  .lead { font-size: 1.15rem; color: var(--text-suau); margin-bottom: 0.5em; }
  .cos { display: grid; gap: 32px; }
  @media (min-width: 820px) { .cos { grid-template-columns: 1.6fr 1fr; align-items: start; } }
  .punts { padding-left: 1.2em; }
  .punts li { margin-bottom: 0.4em; }
  .caixa { background: var(--bg-alt); border-radius: var(--radius); padding: 22px; }
  .visually-h3 { font-size: 1.15rem; }
  .botons { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0 0 12px; }
  dt { font-weight: 700; }
  dd { margin: 0; }
  .enllacos { list-style: none; padding: 0; margin: 0; }
  .captures { list-style: none; padding: 0 0 8px; margin: 0; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; }
  .captures li { flex: none; width: min(62vw, 230px); scroll-snap-align: start; }
  .captures img { border-radius: 16px; border: 1px solid var(--line); }
  section { margin-top: 40px; }
</style>
