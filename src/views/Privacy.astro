---
import Base from '../layouts/Base.astro';
import { routes, otherLang, type Lang } from '../i18n';
import { page, policies, texts } from '../content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { data, Content } = page(lang, 'privadesa');
---

<Base lang={lang} title={data.titol} description={data.descripcio} alternate={routes[otherLang(lang)].privacy}>
  <article class="wrap estret">
    <h1>{data.titol}</h1>
    <Content />
    <h2>{texts(lang).privadesa.apps}</h2>
    <ul>
      {policies(lang).map((p) => <li><a href={routes[lang].policy(p.id)}>{p.data.titol}</a></li>)}
    </ul>
  </article>
</Base>

<style>
  .estret { max-width: 44rem; padding-top: 40px; padding-bottom: 32px; }
</style>
