---
import Base from '../layouts/Base.astro';
import { routes, otherLang, type Lang } from '../i18n';
import { page } from '../content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { data, Content } = page(lang, 'qui-som');
---

<Base lang={lang} title={data.titol} description={data.descripcio} alternate={routes[otherLang(lang)].about}>
  <article class="wrap estret">
    <h1>{data.titol}</h1>
    <Content />
  </article>
</Base>

<style>
  .estret { max-width: 44rem; padding-top: 40px; padding-bottom: 32px; }
  .estret :global(h2) { margin-top: 1.6em; }
  .estret :global(ul) { padding-left: 1.2em; }
  .estret :global(li) { margin-bottom: 0.5em; }
  .estret :global(li::marker) { color: var(--taronja); }
</style>
