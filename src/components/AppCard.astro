---
import type { App } from '../data/apps';
import { routes, type Lang } from '../i18n';
import { appText, texts } from '../content';

interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const { data } = appText(lang, app.id);
---

<a class="targeta" href={routes[lang].app(app.id)}>
  <img src={app.icon} width="72" height="72" alt="" loading="lazy" />
  <div>
    <h3>{data.nom}</h3>
    <p class="suau">{data.resum}</p>
    {app.audience === 'escola' && <span class="tag">{texts(lang).fitxa.per_a_escola}</span>}
  </div>
</a>

<style>
  .targeta {
    display: flex; gap: 16px; align-items: flex-start;
    padding: 20px; border-radius: var(--radius);
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
    color: var(--text); text-decoration: none; height: 100%;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .targeta:hover { transform: translateY(-2px); border-color: var(--taronja); }
  img { width: 72px; height: 72px; border-radius: 18px; flex: none; }
  h3 { margin-bottom: 0.3em; }
  p { margin-bottom: 0.6em; font-size: 0.97rem; }
  @media (prefers-reduced-motion: reduce) { .targeta { transition: none; } .targeta:hover { transform: none; } }
</style>
